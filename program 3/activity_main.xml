<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casio"
        android:layout_marginLeft="310dp"
        android:textSize="30dp"
        android:id="@+id/tex1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:id="@+id/tex2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0"
        android:layout_marginTop="40dp"
        android:inputType="text"
        android:gravity="end"
        />
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/tex2"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:text="1"
        android:textSize="32dp"
        android:id="@+id/but1"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/tex2"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but1"
        android:text="2"
        android:textSize="32dp"
        android:id="@+id/but2"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/tex2"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but2"
        android:text="3"
        android:textSize="32dp"
        android:id="@+id/but3"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/but4"
        android:layout_width="390dp"
        android:layout_height="80dp"
        android:layout_below="@+id/tex2"
        android:layout_marginStart="4dp"
        android:layout_marginTop="30dp"
        android:layout_toEndOf="@+id/but3"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="32dp" />
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but1"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:text="4"
        android:textSize="32dp"
        android:id="@+id/but5"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but2"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but5"
        android:text="5"
        android:textSize="32dp"
        android:id="@+id/but6"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but3"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but2"
        android:text="6"
        android:textSize="32dp"
        android:id="@+id/but7"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/but8"
        android:layout_width="390dp"
        android:layout_height="80dp"
        android:layout_below="@+id/but4"
        android:layout_marginStart="4dp"
        android:layout_marginTop="30dp"
        android:layout_toEndOf="@+id/but3"
        android:text="-"
        android:textColor="@color/white"
        android:textSize="32dp" />
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but5"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:text="7"
        android:textSize="32dp"
        android:id="@+id/but9"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but6"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but1"
        android:text="8"
        android:textSize="32dp"
        android:id="@+id/but10"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but7"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but2"
        android:text="9"
        android:textSize="32dp"
        android:id="@+id/but11"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/but12"
        android:layout_width="390dp"
        android:layout_height="80dp"
        android:layout_below="@+id/but8"
        android:layout_marginStart="4dp"
        android:layout_marginTop="30dp"
        android:layout_toEndOf="@+id/but3"
        android:text="/"
        android:textColor="@color/white"
        android:textSize="32dp" />
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but9"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:text="."
        android:textSize="32dp"
        android:id="@+id/but13"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but10"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but1"
        android:text="0"
        android:textSize="32dp"
        android:id="@+id/but14"
        android:textColor="@color/white"/>
    <Button
        android:layout_width="76dp"
        android:layout_height="81dp"
        android:layout_below="@+id/but11"
        android:layout_marginTop="30dp"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/but2"
        android:text="c"
        android:textSize="32dp"
        android:id="@+id/but15"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/but16"
        android:layout_width="390dp"
        android:layout_height="80dp"
        android:layout_below="@+id/but12"
        android:layout_marginStart="4dp"
        android:layout_marginTop="30dp"
        android:layout_toEndOf="@+id/but3"
        android:text="x"
        android:textColor="@color/white"
        android:textSize="32dp" />


    <Button
        android:layout_below="@+id/but14"
        android:id="@+id/but17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="="
        android:textSize="30dp"
        android:layout_marginTop="20dp" />


</RelativeLayout>